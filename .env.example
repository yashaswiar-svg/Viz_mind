APP_NAME=VizMind
APP_VERSION=0.2.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

API_PREFIX=/api
API_VERSION=v1

DATABASE_URL=postgresql+asyncpg://vizmind:vizmind_password@localhost:5432/vizmind
DATABASE_TEST_URL=postgresql+asyncpg://vizmind:vizmind_password@localhost:5432/vizmind_test

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SECRET_KEY=replace-with-a-secure-random-production-secret-key-32-chars
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-secret-key-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

AUTH_ENABLED=true
AUTH_TEST_BYPASS=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

STORAGE_PATH=./storage/datasets
MAX_UPLOAD_SIZE_MB=50

LLM_ENABLED=false
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

SENTRY_DSN=
